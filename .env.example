# Copia este archivo como ".env" (cp .env.example .env). NO subas el ".env" real al repositorio.
# Todos los valores son ficticios y solo para el laboratorio.

# --- PostgreSQL ---
POSTGRES_DB=mensajeria
POSTGRES_USER=mensajeria_user
POSTGRES_PASSWORD=cambia_esta_clave

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=cambia_esta_clave_mongo

# --- Redis ---
REDIS_PASSWORD=cambia_esta_clave_redis

# --- Worker de sincronizacion ---
# Cada cuantos segundos revisa la tabla outbox
WORKER_INTERVALO_SEGUNDOS=2

# --- Estado temporal (Redis) ---
# Segundos de vigencia de la ultima posicion de un repartidor
TTL_POSICION_SEGUNDOS=60
